@PACKAGE_INIT@

set(JA2Engine_VERSION "@JA2_ENGINE_SDK_VERSION@")
set(JA2Engine_COMPATIBILITY_LINE "@JA2_ENGINE_SDK_COMPATIBILITY_LINE@")
set(JA2Engine_STABILITY "@JA2_ENGINE_SDK_STABILITY@")
set(JA2Engine_SOURCE_COMPATIBILITY
  "@JA2_ENGINE_SDK_SOURCE_COMPATIBILITY@")
set(JA2Engine_BINARY_COMPATIBILITY
  "@JA2_ENGINE_SDK_BINARY_COMPATIBILITY@")
set_and_check(JA2Engine_COMPATIBILITY_MANIFEST
  "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/JA2Engine/compatibility/JA2EngineCompatibility.json")
# Engine/Core follows the host repository's static MSVC CRT ABI. CMake runtime
# selection is not transitive for static archives, so external Windows targets
# must apply this exported value to MSVC_RUNTIME_LIBRARY before compiling.
set(JA2Engine_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")

include("${CMAKE_CURRENT_LIST_DIR}/JA2EngineTargets.cmake")

set(JA2Engine_SUPPORTED_COMPONENTS EngineCore RuntimeAdapter)
set(JA2Engine_EngineCore_FOUND FALSE)
if(TARGET JA2::EngineCore)
  set(JA2Engine_EngineCore_FOUND TRUE)
endif()

# RuntimeAdapter's public contract includes EngineCore. Treat the adapter
# component as available only when both imported targets are complete.
set(JA2Engine_RuntimeAdapter_FOUND FALSE)
if(TARGET JA2::RuntimeAdapter AND JA2Engine_EngineCore_FOUND)
  set(JA2Engine_RuntimeAdapter_FOUND TRUE)
endif()

check_required_components(JA2Engine)
